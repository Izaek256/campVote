# CampVote environment template
# Copy to .env and fill in the values. Never commit a populated .env file.
# This file lists every variable the application reads; production deployments
# must provide all required ones.
#
# Docker files in this repository:
#   docker-compose.yaml          API only, host networking, database external
#   docker-compose.wsl.yaml      WSL/Linux full stack: PostgreSQL + API + web
#   docker-compose.windows.yaml  PostgreSQL only, for Docker Desktop on Windows
# The API-only file hands this file to the container with `env_file`, unchanged.
# The WSL full-stack file overrides DATABASE_URL and the public URLs so the
# containers can find each other; everything else still comes from here.

# ── Core ─────────────────────────────────────────────────────────────────────
# Shown in browser titles, emails, TOTP issuers and the admin header.
APP_NAME=CampVote
APP_ENV=development
# Where a browser reaches THIS API. Uploaded-file URLs are built from it, so on
# localhost it must name the API's own port (8080), not the frontend's 3000; the
# API logs a warning when APP_URL and the listening port disagree on localhost.
APP_URL=http://localhost:8080

# Required: at least 32 characters. Generate: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-local-secret-32plus-chars

# ── Logging ───────────────────────────────────────────────────────────────────
# The server prints one format for every line (see apps/api/internal/logging).
# Colour is added only when stderr is a terminal; LOG_COLOR=always forces it on
# through a pipe and NO_COLOR (any value) forces plain text off.
LOG_COLOR=auto
# Print Gin's "[GIN-debug] GET /api/v1/..." route dump at boot. Off by default,
# since it is over a hundred lines before the server is listening; turn it on
# when the route wiring itself is what you are debugging.
LOG_ROUTES=false

# ── Database ──────────────────────────────────────────────────────────────────
# The API reads DATABASE_URL to find PostgreSQL; docker-compose.yaml has no
# database service and builds no URL, so the same string works for the container
# and for anything run on the host (go run ./cmd/server, ./cmd/migrate, tests, the
# editor's database tooling). Point it at a database that is already running: one
# you installed, one from `docker run` (see README Option 3), or a managed
# service. Inside a `docker run` container on the default bridge network,
# `localhost` is the container, so use the database's real host or --network=host.
DATABASE_URL=postgres://campvote_dev:change-me-local-only@localhost:5432/campvote_dev?sslmode=disable
# The driver percent-decodes the password inside DATABASE_URL, so a password
# containing @, %, / or # must be written percent-encoded here (@ as %40) and raw
# everywhere else. A password you type in both places is easier to keep
# alphanumeric.
# Used by docker-compose.windows.yaml (PostgreSQL in Docker Desktop) and by the
# API only when DATABASE_URL is unset, where it builds a DSN from the POSTGRES_*
# parts. Keep these in step with DATABASE_URL.
POSTGRES_DB=campvote_dev
POSTGRES_USER=campvote_dev
POSTGRES_PASSWORD=campvote_dev_password

# ── Redis ─────────────────────────────────────────────────────────────────────
# Optional. It backs the election scheduler (background open/close), the job
# queue and the cache, and nothing here containers it: docker-compose.yaml runs
# the API only, so leave this empty unless you run Redis yourself.
# REDIS_URL= unset entirely falls back to redis://localhost:6380 and the API dials
# it whether or not Redis answers, reporting redis as off in /api/health once it
# fails; REDIS_URL= (empty, set) means "no Redis" and turns caching, jobs and cron
# off on purpose. Without a queue, elections open and close lazily when a request
# reaches them.
REDIS_URL=

# ── Mail ──────────────────────────────────────────────────────────────────────
# MAIL_MAILER picks the driver: smtp | resend | mailgun | postmark | sendgrid | ses | log
# `log` never sends: it prints each message, verification codes and reset links
# included, to stdout and saves an HTML copy under MAIL_LOG_PATH. With the API in
# Docker that means `docker compose logs api` for codes and one volume for the
# files. Left unset in development, the API tries SMTP on localhost:1025 first
# and falls back to the log; name a driver explicitly to choose rather than wait
# for the probe. Set MAIL_MAILER=smtp (and the SMTP_* values below) to actually
# deliver to user inboxes.
MAIL_MAILER=log
MAIL_LOG_PATH=storage/mail
# Point the smtp driver at a real mail server, or at a local catcher (Mailpit,
# MailHog) you run yourself. Inside the container localhost:1025 means the
# container; with host networking it means the machine.
# MAIL_MAILER=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_ENCRYPTION=starttls   # tls for port 465, starttls for 587, none for a local catcher
# SMTP_USERNAME=your-mailbox@example.com
# SMTP_PASSWORD=your-app-password
# Sender. For SMTP, leave MAIL_FROM unset and the API uses SMTP_USERNAME:
# providers reject a From address the authenticated mailbox does not own.
# For API providers (Resend, Mailgun, Postmark, SendGrid, SES) this must be an
# address that provider has verified, so set it explicitly.
# MAIL_FROM=noreply@your-domain.example
MAIL_FROM_NAME=CampVote
# MAIL_ECHO_CODES: dev-only opt-in. When true (and APP_ENV is not production),
# verification codes are returned in the API response for /auth/send-verification
# and /auth/signup/initiate — but ONLY when mail delivery actually failed (no
# mailer, or a send error). This lets the registration flow complete without a
# working mail server. Default false: even in development the code is not echoed,
# so check the logs or storage/mail/ for it. Never set this in production.
# MAIL_ECHO_CODES=true

# ── File storage ─────────────────────────────────────────────────────────────
# STORAGE_DRIVER: local | minio | s3 | r2 | b2
# Both paths below are relative to where the process starts: beside .env on the
# host, under /app in the API container, where docker-compose.yaml mounts the
# campvote_storage volume over /app/storage so files survive `docker compose
# down` (but not `down -v`). Keeping the defaults means one volume covers uploads
# and log-driver mail instead of two locations.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=storage/app
# ALLOW_LOCAL_STORAGE_IN_PRODUCTION=false

# For S3-compatible (minio, r2, s3):
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=campvote-local
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1

# ── Auth & Security ───────────────────────────────────────────────────────────
# Require email verification before login (false lets existing accounts keep working)
REQUIRE_EMAIL_VERIFICATION=false
# Per-account brute-force lockout; 0 disables the lock
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCKOUT_MINUTES=15
# Check passwords against breach corpus (network required)
PASSWORD_BREACH_CHECK=false

# CORS_ORIGINS: comma-separated list of allowed web origins
CORS_ORIGINS=http://localhost:3000

# ── Eligibility / signup ─────────────────────────────────────────────────────
# Email domains that determine role and registration access.
# STUDENT_EMAIL_DOMAIN: only this domain may self-register as voters.
# ADMIN_EMAIL_DOMAIN: administrators must use this domain (cannot self-register).
# Both are case-insensitive and must match exactly after the final @.
STUDENT_EMAIL_DOMAIN=std.must.ac.ug
ADMIN_EMAIL_DOMAIN=must.ac.ug

# ── Demo data ────────────────────────────────────────────────────────────────
# Set to true ONLY for local development to seed demo voter accounts. The API
# seeds at startup when APP_ENV=development and this is true, in the container too.
# Never use in production.
# SEED_DEMO_DATA=false

# ── First-admin bootstrap ─────────────────────────────────────────────────────
# Set these to create the first administrator on server startup if none exists
# Remove them immediately after. Never commit populated values.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-unique-local-password
# BOOTSTRAP_ADMIN_FIRST_NAME=First
# BOOTSTRAP_ADMIN_LAST_NAME=Admin

# ── Optional: OAuth social login ──────────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# OAUTH_FRONTEND_URL=http://localhost:3000

# ── Optional: OpenTelemetry tracing ──────────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ── Optional: AI (Vercel AI Gateway) ─────────────────────────────────────────
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_MODEL=anthropic/claude-sonnet-4-6

# ── Frontend ─────────────────────────────────────────────────────────────────
# Where the browser reaches the API. apps/web/next.config.ts loads this file,
# so the web app picks the value up; it is inlined into the JS bundle at build
# time, so it must be a URL the browser can reach — not an internal Docker
# hostname — and changing it means rebuilding/restarting the web app.
# Leave it set on localhost. In a deployment that proxies /api (API_PROXY_TARGET
# below), leave it unset instead: an empty value means "this origin", which is
# what lets every Vercel preview hostname work without its own value.
NEXT_PUBLIC_API_URL=http://localhost:8080
# Deployment-only. When the web app is hosted apart from the API (Vercel, for
# example), set this to the API base. Next then serves /api and /files itself,
# so the browser makes same-origin calls: no CORS, and the API's SameSite=Lax
# cookies stay first-party. Leave NEXT_PUBLIC_API_URL unset alongside it.
# See docs/operations/vercel-proxy.md. Unset means no proxy.
# API_PROXY_TARGET=http://194.36.88.77:8080
# Campus identity and email domains (must match backend STUDENT_EMAIL_DOMAIN and ADMIN_EMAIL_DOMAIN)
NEXT_PUBLIC_CAMPUS_NAME=Campus
NEXT_PUBLIC_ELECTION_AUTHORITY=Campus Electoral Commission
NEXT_PUBLIC_STUDENT_EMAIL_DOMAIN=std.must.ac.ug
NEXT_PUBLIC_STAFF_EMAIL_DOMAIN=must.ac.ug
