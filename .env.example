# TEMPLATE ONLY. Match names to the pinned Grit scaffold before use.
# Do not place real credentials in this file.

APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8080

# Local-only example. Use a unique local password and keep .env untracked.
DATABASE_URL=postgres://campvote_dev:change-me-local-only@localhost:5432/campvote_dev?sslmode=disable

# Configure these only after verifying the generated authentication integration.
# SESSION_SECRET=replace-with-a-long-random-local-secret
# JWT_SECRET=replace-with-a-long-random-local-secret
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=

# Optional services; leave unset unless the project actually enables them.
# REDIS_URL=redis://localhost:6379/0
# SMTP_HOST=localhost
# SMTP_PORT=1025
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=campvote-local
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Authentication hardening (see docs/auth.md).
# Default false so existing local accounts keep working; production should set true.
# REQUIRE_EMAIL_VERIFICATION=false
# Per-account brute-force lockout. Set LOGIN_MAX_ATTEMPTS=0 to disable the lock.
# LOGIN_MAX_ATTEMPTS=10
# LOGIN_LOCKOUT_MINUTES=15
# Optional: check passwords against a breach list (needs network access).
# PASSWORD_BREACH_CHECK=false

# One-time first-administrator bootstrap, used only with:
#   cd apps/api && go run ./cmd/bootstrap
# No administrator is seeded. Set these for that single run, then remove them.
# BOOTSTRAP_ADMIN_EMAIL=admin@must.ac.ug
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-unique-local-password
# BOOTSTRAP_ADMIN_FIRST_NAME=First
# BOOTSTRAP_ADMIN_LAST_NAME=Admin
