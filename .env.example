# campVote environment template
# Copy to .env and fill in the values. Never commit a populated .env file.
# This file lists every variable the application reads; production deployments
# must provide all required ones.

# ── Core ─────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_URL=http://localhost:8080

# Required: at least 32 characters. Generate: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-local-secret-32plus-chars

# ── Database ──────────────────────────────────────────────────────────────────
# For compose: postgres://campvote_dev:campvote_dev_password@localhost:5432/campvote_dev?sslmode=disable
# For local: replace host/port/credentials as needed.
DATABASE_URL=postgres://campvote_dev:change-me-local-only@localhost:5432/campvote_dev?sslmode=disable
POSTGRES_PASSWORD=campvote_dev_password

# ── Redis ─────────────────────────────────────────────────────────────────────
# Required for the election scheduler (background open/close) and job queue.
# Leave empty to disable background jobs (elections open/close lazily on request).
REDIS_URL=redis://localhost:6379/0

# ── Mail ──────────────────────────────────────────────────────────────────────
# MAIL_MAILER picks the driver: smtp | resend | mailgun | postmark | sendgrid | ses | log
# For local development with Mailpit running via compose:
MAIL_MAILER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=noreply@campvote.local
MAIL_FROM_NAME=campVote
# SMTP_USERNAME=
# SMTP_PASSWORD=

# ── File storage ─────────────────────────────────────────────────────────────
# STORAGE_DRIVER: local | minio | s3 | r2 | b2
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=storage/app
# ALLOW_LOCAL_STORAGE_IN_PRODUCTION=false

# For S3-compatible (minio, r2, s3):
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=campvote-local
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1

# ── Auth & Security ───────────────────────────────────────────────────────────
# Require email verification before login (false lets existing accounts keep working)
REQUIRE_EMAIL_VERIFICATION=false
# Per-account brute-force lockout; 0 disables the lock
LOGIN_MAX_ATTEMPTS=10
LOGIN_LOCKOUT_MINUTES=15
# Check passwords against breach corpus (network required)
PASSWORD_BREACH_CHECK=false

# CORS_ORIGINS: comma-separated list of allowed web origins
CORS_ORIGINS=http://localhost:3000

# ── Eligibility / signup ─────────────────────────────────────────────────────
# Email domains that determine role and registration access.
# STUDENT_EMAIL_DOMAIN: only this domain may self-register as voters.
# ADMIN_EMAIL_DOMAIN: administrators must use this domain (cannot self-register).
# Both are case-insensitive and must match exactly after the final @.
STUDENT_EMAIL_DOMAIN=std.must.ac.ug
ADMIN_EMAIL_DOMAIN=must.ac.ug

# ── Demo data ────────────────────────────────────────────────────────────────
# Set to true ONLY for local development to seed demo voter accounts.
# Never use in production.
# SEED_DEMO_DATA=false

# ── First-admin bootstrap ─────────────────────────────────────────────────────
# Set these to create the first administrator on server startup if none exists
# Remove them immediately after. Never commit populated values.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-unique-local-password
# BOOTSTRAP_ADMIN_FIRST_NAME=First
# BOOTSTRAP_ADMIN_LAST_NAME=Admin

# ── Optional: OAuth social login ──────────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# OAUTH_FRONTEND_URL=http://localhost:3000

# ── Optional: OpenTelemetry tracing ──────────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ── Optional: AI (Vercel AI Gateway) ─────────────────────────────────────────
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_MODEL=anthropic/claude-sonnet-4-6

# ── Frontend ─────────────────────────────────────────────────────────────────
# Campus identity and email domains (must match backend STUDENT_EMAIL_DOMAIN and ADMIN_EMAIL_DOMAIN)
NEXT_PUBLIC_CAMPUS_NAME=Campus
NEXT_PUBLIC_ELECTION_AUTHORITY=Campus Electoral Commission
NEXT_PUBLIC_STUDENT_EMAIL_DOMAIN=std.must.ac.ug
NEXT_PUBLIC_STAFF_EMAIL_DOMAIN=must.ac.ug
